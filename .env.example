# ---------------------------------------------------------------------------
# Intray configuration
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port the server listens on.
PORT=3000

# Directory where the SQLite database file is stored. Mount this as a volume
# in Docker so your data survives container restarts/upgrades.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# DB_ENCRYPTION_KEY — REQUIRED. Encrypts the SQLite database file at rest
# using SQLCipher-compatible encryption (via better-sqlite3-multiple-ciphers).
#
# Generate a random 64-character hex key with:
#   openssl rand -hex 32
#
# Store it ONLY in this .env file. Do not commit it, do not back it up
# alongside the database file itself, and do not lose it — there is no
# recovery mechanism. If you lose this key, the data in the .db file is
# permanently unreadable, by design.
# ---------------------------------------------------------------------------
DB_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AUTH_PASSWORD — OPTIONAL. If set, the app requires this password (via a
# simple session-cookie login) before any API or UI access. If left unset,
# the app runs with no authentication at all — only do this on a strictly
# local/LAN network you trust.
#
# Set this before exposing Intray beyond your home network, and always pair
# it with HTTPS (see README for reverse proxy guidance). Do not expose this
# app to the public internet without setting AUTH_PASSWORD.
# ---------------------------------------------------------------------------
AUTH_PASSWORD=
