{
  "name": "intray",
  "version": "1.0.0",
  "private": true,
  "description": "Intray — a self-hosted, single-user GTD (Getting Things Done) app.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build -w client",
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev -w client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
